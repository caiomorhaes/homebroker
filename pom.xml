<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.caiomorhaes.homebroker</groupId>
    <artifactId>homebroker</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>homebroker-core</module>
        <module>homebroker-api</module>
        <module>homebroker-events</module>
        <module>homebroker-marketdata</module>
        <module>homebroker-matching</module>
        <module>homebroker-risk</module>
        <module>homebroker-test-e2e</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Todas as versões importantes do projeto ficam aqui no topo -->
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM do Spring Boot: importa a lista de versões testadas pelo time do Spring.
                 Não adiciona nenhuma dependência, só define as versões (o "cardápio pronto") -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>